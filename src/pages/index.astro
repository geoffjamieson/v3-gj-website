---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import WorkList from '../components/WorkList.astro';
import { site } from '../data/site';

const caseStudies = (await getCollection('case-studies')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base>
  <section class="intro">
    <h1>Hey, I'm Geoff.</h1>
    <p class="subheader">Front-end developer and former startup founder.</p>
    <p>
      I like building things. Most of my experience is on the front end, but I've been branching out
      on purpose and picking up more of the stack. I'm curious, and I like seeing the big picture and
      knowing how everything works.
    </p>
    <p class="actions">
      <Button href="#work">See my work</Button>
      <Button href="#contact" variant="secondary">Get in touch</Button>
    </p>
  </section>

  <section id="work" aria-labelledby="work-heading">
    <h2 id="work-heading">Work</h2>
    <WorkList studies={caseStudies} />
  </section>

  <section aria-labelledby="about-heading">
    <h2 id="about-heading">About</h2>
    <p>
      I came to development from a non-traditional background. I studied business, started an art
      marketplace, then taught myself to code so I could build my own ideas. I like digging in, learning new things, and building things.
    </p>
    <p>
      Outside of work, I like hiking, rock climbing, cooking, <a href={site.storygraph}>reading</a>,
      listening to <a href={site.bandcamp}>music</a>, and collecting CDs and vinyl.
    </p>
    <p><a href="/about">More about me</a></p>
  </section>
</Base>
