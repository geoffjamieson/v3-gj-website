---
import '../styles/global.css';
import { site } from '../data/site';
import Logo from '../components/logo/Logo.astro';
import LogoColor from '../components/logo/LogoColor.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { LOGO_COLORS } from '../components/logo/colors';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
// Without the trailing slash the build adds (/about/), so it matches the site's links (/about)
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site);
// The link preview image, made from the dark name card option (1200 by 630)
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {/* The SVG favicon follows the logo colour. The pink PNG is for browsers without SVG favicons, like older Safari */}
    <link rel="icon" type="image/svg+xml" href={`/favicon/${LOGO_COLORS[0].slice(1)}.svg`} />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    {/* Link previews in LinkedIn, Slack, iMessage, email and so on */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, front-end developer in Hamilton, Ontario`} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Vercel Web Analytics: cookieless page views. Same as their Astro component, without the package */}
    <script is:inline>
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>

    {/* Apply the visitor's saved theme and logo colour (logo and favicon) before the page paints, so it doesn't flash */}
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
        const color = localStorage.getItem('logo-color');
        if (color) {
          document.documentElement.style.setProperty('--logo-color', color);
          document.querySelector('link[rel="icon"][type="image/svg+xml"]').href = '/favicon/' + color.slice(1) + '.svg';
        }
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="brand">
        <a href="/" class="site-name" aria-label={`${site.name}, home`}><Logo /></a>
        <LogoColor />
      </div>
      <div class="header-end">
        <nav aria-label="Main">
          <ul>
            <li><a href="/#work">Work</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    {/* The contact section doubles as the footer on every page */}
    <footer id="contact" class="site-footer" aria-labelledby="contact-heading">
      <h2 id="contact-heading">Let's talk</h2>
      <p>
        I'm open to full-time roles, and happy to chat about work or anything else. Feel free to
        reach out 🤠
      </p>
      <ul class="contact-links">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.linkedin}>LinkedIn</a></li>
        <li><a href={site.github}>GitHub</a></li>
      </ul>
    </footer>
  </body>
</html>
